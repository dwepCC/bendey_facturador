# Copia este archivo a .env.prod en el VPS (NO subir .env.prod a GitHub)
# cp .env.prod.example .env.prod

###> Symfony ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
###< Symfony ###

###> MySQL (docker-compose.prod.yml) ###
MYSQL_ROOT_PASSWORD=root_password_muy_seguro
MYSQL_DATABASE=bendey_facturador
MYSQL_USER=facturador
MYSQL_PASSWORD=password_mysql_muy_seguro
###< MySQL ###

###> Puertos expuestos en el VPS ###
APP_PORT=8000
PHPMYADMIN_PORT=8080
###< Puertos ###

###> Seeds (solo primer deploy: RUN_ADMIN_SEED=1) ###
RUN_ADMIN_SEED=0
RUN_EMPRESAS_IMPORT=0
###< Seeds ###

